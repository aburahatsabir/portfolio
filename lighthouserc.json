{
  "ci": {
    "collect": {
      "numberOfRuns": 1,
      "startServerCommand": "npm run preview -- --host 127.0.0.1 --port 4173",
      "startServerReadyPattern": "Local",
      "url": [
        "http://127.0.0.1:4173/",
        "http://127.0.0.1:4173/about",
        "http://127.0.0.1:4173/work",
        "http://127.0.0.1:4173/blog",
        "http://127.0.0.1:4173/contact",
        "http://127.0.0.1:4173/certifications",
        "http://127.0.0.1:4173/privacy",
        "http://127.0.0.1:4173/cookies",
        "http://127.0.0.1:4173/blog/resume-writing-guide-getting-shortlisted",
        "http://127.0.0.1:4173/blog/how-to-learn-computer-networking"
      ],
      "settings": {
        "preset": "desktop",
        "chromeFlags": "--no-sandbox --disable-dev-shm-usage"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.7
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.85
          }
        ]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
