{
    "trailingSlash": false,
    "redirects": [
        {
            "source": "/blog/blog-02",
            "destination": "/blog/resume-writing-guide-getting-shortlisted",
            "permanent": true
        },
        {
            "source": "/blog/blog-semrush-bing-ai",
            "destination": "/blog/how-to-learn-computer-networking",
            "permanent": true
        }
    ],
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "X-Frame-Options",
                    "value": "DENY"
                },
                {
                    "key": "Referrer-Policy",
                    "value": "strict-origin-when-cross-origin"
                },
                {
                    "key": "Permissions-Policy",
                    "value": "camera=(), microphone=(), geolocation=()"
                }
            ]
        }
    ]
}
